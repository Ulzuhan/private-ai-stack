# private-ai-stack configuration — copy to .env and adjust.
# Every setting has a working default: the stack runs without a .env file.

# ---------------------------------------------------------------------------
# Models (shared across the stack)
# ---------------------------------------------------------------------------
# One generation model serves both chat (Open WebUI) and RAG (Reed): loading
# two models at once does not fit consumer hardware. The GPU override
# (docker-compose.gpu.yml) re-defaults this to qwen3.5:9b on its own.
GENERATION_MODEL=qwen3.5:4b
EMBEDDING_MODEL=embeddinggemma

# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------
# Default: the containerized Ollama service. For a native Ollama on the host
# (the fast path on Apple Silicon — Docker has no Metal passthrough), use the
# BYO override instead of editing this:
#   docker compose -f docker-compose.yml -f docker-compose.byo.yml up -d
# OLLAMA_BASE_URL=http://ollama:11434

# ---------------------------------------------------------------------------
# Ports (bound to 127.0.0.1 only — use the production override to go further)
# ---------------------------------------------------------------------------
WEBUI_PORT=3000
REED_PORT=8000

# ---------------------------------------------------------------------------
# Reed (RAG service) — see https://github.com/Ulzuhan/reed for every knob
# ---------------------------------------------------------------------------
REED_COLLECTION=reed_chunks
REED_LOG_LEVEL=INFO
# tmpfs budget for the upload spool: keep at ~2x the max upload size.
REED_TMPFS_SIZE=64m
# Set to require an X-API-Key header on Reed's /v1 routes (ASCII only).
# Required before exposing Reed beyond localhost.
REED_API_KEY=

# Bare knobs — leave commented to keep Reed's calibrated, model-aware presets.
# Setting them (even to empty) overrides the preset on purpose.
# REED_MIN_EVIDENCE_SCORE=
# REED_EMBED_QUERY_PREFIX=
# REED_EMBED_DOC_PREFIX=
